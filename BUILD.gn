import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/templates/blueos_dso.gni")
import("//build/toolchain/blueos.gni")

build_rust("librs") {
  crate_type = "rlib"
  crate_name = "librs"
  sources = [ "src/lib.rs" ]
  deps = [
    "//external/vendor/semihosting-0.1.20:semihosting",
    "//external/vendor/spin-0.9.8:spin",
    "//kernel/header:blueos_header",
    "//kernel/scal:blueos_scal",
    "//libc",
  ]
  configs += [ "//build/boards/${board}:kernel_config" ]
}

run_clippy("librs_clippy") {
  deps = [ ":librs" ]
}

build_rust("librs_swi") {
  crate_type = "rlib"
  crate_name = "librs"
  sources = [ "src/lib.rs" ]
  deps = [
    "//external/vendor/spin-0.9.8:spin",
    "//kernel/header:blueos_header",
    "//kernel/scal:blueos_scal_swi",
    "//libc",
  ]

  # librs_swi will be used in apps dynamically loaded.
  configs += [ "//build/boards/${board}:app_config" ]
}

run_clippy("librs_swi_clippy") {
  deps = [ ":librs_swi" ]
}

# C19 §8: the system shared libc. Built from the same `librs` sources as a PIC
# cdylib, linked through the SWI syscall ABI (`blueos_scal_swi`, not
# `direct_syscall_handler`), with SONAME `libc.so.1`. It must not resolve or
# reference any kernel Rust/C symbol; every undefined symbol comes from the PIC
# sysroot or the scal SWI shim (checked by `check_blueos_elf.py`).
#
# C19 §8.2: `librs.exports` is the frozen export surface. The postlink freeze
# localizes every dynsym entry outside the manifest and the contract gate
# asserts the dynamic symbol table equals it exactly.
blueos_dso("libc") {
  crate_name = "librs"
  soname = "libc.so.1"
  sources = [ "src/lib.rs" ]
  cfgs = [ "librs_dso" ]
  deps = [
    "//external/vendor/spin-0.9.8:spin",
    "//kernel/header:blueos_header",
    "//kernel/scal:blueos_scal_swi",
    "//libc",
  ]
  export_manifest = "librs.exports"
  if (board == "qemu_riscv32") {
    deps += [ "//librs/atomic:atomic_dso" ]
  }
}

# Phase-2 dynamic-application start object. Each architecture receives the
# same `info` pointer in its first argument register and tail-calls
# `__librs_start_main(main, info)` without depending on the kernel's GP/TLS
# state. The board ABI config supplies the assembler target flags.
config("blueos_scrt1_config") {
  if (board == "qemu_riscv64") {
    cflags = [
      "-march=rv64imac",
      "-mabi=lp64",
    ]
  } else if (board == "qemu_riscv32") {
    cflags = [
      "-march=rv32imc",
      "-mabi=ilp32",
    ]
  }
}

static_library("blueos_scrt1") {
  if (board == "qemu_mps2_an385" || board == "qemu_mps3_an547") {
    sources = [ "start/arm/blueos_scrt1.S" ]
  } else if (board == "qemu_riscv32" || board == "qemu_riscv64") {
    sources = [ "start/riscv/blueos_scrt1.S" ]
  } else if (board == "qemu_virt64_aarch64") {
    sources = [ "start/aarch64/blueos_scrt1.S" ]
  } else {
    # Keep GN generation working for boards that do not enable dynamic apps;
    # no target on those boards is allowed to depend on this archive yet.
    sources = [ "start/arm/blueos_scrt1.S" ]
  }
  configs += [
    "//build/boards/${board}:kernel_config",
    ":blueos_scrt1_config",
  ]
}

build_rust("librs_unittest_image") {
  testonly = true
  crate_type = "bin"
  sources = [ "src/lib.rs" ]
  edition = "2021"
  deps = [
    "//external/vendor/semihosting-0.1.20:semihosting",
    "//external/vendor/spin-0.9.8:spin",
    "//kernel/header:blueos_header",
    "//kernel/kernel:blueos",
    "//kernel/rsrt",
    "//kernel/scal:blueos_scal",
    "//libc",
  ]
  linker_script = default_linker_script
  proc_macro_deps = [ "//kernel/test_harness:blueos_test_macro" ]
  rustflags = [ "--test" ]
}

run_clippy("librs_unittest_image_clippy") {
  testonly = true
  deps = [ ":librs_unittest_image" ]
}

if (defined(qemu_use_esp32_loader) && qemu_use_esp32_loader) {
  gen_esp32_qemu_runner("librs_unittest_runner") {
    testonly = true
    elf = ":librs_unittest_image"
    chip = "${chip}"
    bootloader = qemu_esp32_bootloader_bin
    partition_table = qemu_esp32_partition_table_bin
    qemu = "$qemu_exe"
    machine = "$qemu_machine"
    semihosting = true
    qemu_args = qemu_extra_args
    block_args = qemu_block_args
  }
} else {
  gen_qemu_runner("librs_unittest_runner") {
    testonly = true
    img = ":librs_unittest_image"
    qemu = "$qemu_exe"
    machine = "$qemu_machine"
    semihosting = true
    qemu_args = qemu_extra_args
    block_img = "librs_unittest_block.img"
    block_args = qemu_block_args
  }
}

run_qemu_check("run_librs_unittest") {
  testonly = true
  runner = ":librs_unittest_runner"
  if (coverage) {
    img = ":librs_unittest_image"
    checker = "src/coverage.checker"
  } else {
    checker = "src/unittests.checker"
  }
}

group("check_librs") {
  testonly = true
  deps = [
    ":run_librs_unittest",
    "tests/integration_test:run_librs_integration_test",

    # wait for virtio
    # "tests/posixtestsuite:run_librs_posix_testsuite",
  ]
}

group("check_librs_linux_emulation") {
  testonly = true
  deps = [ "tests/linux_emulation_test:run_librs_linux_emulation" ]
}

group("check_librs_by_clippy") {
  testonly = true
  deps = [
    ":librs_clippy",
    ":librs_swi_clippy",
    ":librs_unittest_image_clippy",
  ]
}
