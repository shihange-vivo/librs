import("//build/boards/${board}.gni")

# C35 §14.2: `__atomic_*` builtins for the no-A RV32 IMC DSO.
#
# `riscv32imc-vivo-blueos` declares `+m,+c` (no `+a`), so `target_has_atomic`
# is false and rustc/LLVM lowers `core::sync::atomic` and `spin` into
# `__atomic_*` library calls. The DSO must resolve them without referencing
# kernel symbols, so this is a self-contained copy of the kernel's
# compiler-rt `atomic.c` paired with a local M-mode IRQ shim (BlueOS runs the
# DSO in M-mode, so it may clear/set `mstatus.MIE` itself). The lock-free
# fast paths (pointer CAS on IMAC) still compile through; only the
# non-lock-free fallbacks take the IRQ-disable path.
static_library("atomic_dso") {
  sources = [
    "atomic.c",
    "atomic_irq_shim.c",
  ]
}
